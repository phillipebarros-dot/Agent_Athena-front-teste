# ============================================================================
# Athena Frontend, variáveis de ambiente (SERVIDOR)
# Copie para .env.local (dev) e configure via Secret Manager na Cloud Run (prod).
# NENHUMA destas tem prefixo NEXT_PUBLIC_, nenhum segredo chega ao navegador.
# NÃO comite .env.local nem valores reais.
# ============================================================================

# URL do backend Python (Cloud Run). Ex.: https://athena-backend-xxxxx.us-central1.run.app
ATHENA_BACKEND_URL=

# Token Bearer do backend (= MCP_AUTH_TOKEN do backend). Fica SÓ no servidor.
# ⚠️ Rotacione o token que foi exposto antes de subir.
ATHENA_BACKEND_TOKEN=

# Segredo para assinar o cookie de sessão. Gere um aleatório forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Domínios de e-mail autorizados a entrar
ALLOWED_EMAIL_DOMAINS=grupoom.com.br,opusmultipla.com.br

# E-mails com acesso ao painel de auditoria
ADMIN_EMAILS=andrei@grupoom.com.br,phillipe.barros@grupoom.com.br,camilo.ferreira@grupoom.com.br,gabriel.oliveira@grupoom.com.br

# Rate limit por IP por minuto (defesa contra abuso/custo)
RATE_LIMIT_PER_MINUTE=30

# Login-stub de desenvolvimento. Em produção deixe FALSE e use Google OAuth.
ATHENA_DEV_LOGIN=true
